[Unit]
Description=Investment Research GitHub Webhook Deploy Listener
Documentation=https://github.com/brent-jenkins/investment-research-sp500
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/investment-research

ExecStart=/usr/bin/python3.11 /root/investment-research/webhook_listener.py

# Restart policy: always restart, with a 10-second backoff
Restart=always
RestartSec=10

# KillMode=process (NOT the systemd default of control-group) -- required,
# not cosmetic. deploy_steps() (deploy.sh) restarts THIS service as its own
# last restart step, and webhook_listener.py's trigger_deploy() spawns
# deploy.sh as a direct child process of this unit. With the default
# control-group KillMode, "systemctl restart investment-research-webhook"
# sends the kill signal to the ENTIRE cgroup -- including the still-running
# deploy.sh process that issued the restart command -- silently truncating
# the deploy before it reaches its `systemctl status` output and, critically,
# before verify_deploy.sh ever runs. Confirmed as a real failure, not a
# theoretical one: the first genuine GitHub-triggered deploy through this
# service was cut short at exactly this point (see CLAUDE.md's "GitHub
# webhook deploy" for the incident). KillMode=process targets only this
# unit's own tracked main PID on stop/restart, leaving deploy.sh (now
# reparented, not killed) free to run to completion. Trade-off, accepted
# deliberately: if the listener process crashes uncleanly, KillMode=process
# means any lingering child of it is NOT auto-reaped by systemd the way the
# default would -- acceptable here since the listener's only child is ever
# a single deploy.sh invocation, not general-purpose forking.
KillMode=process

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
# Secrets — set the real value in
# /etc/systemd/system/investment-research-webhook.service.d/secrets.conf
# (symlinked from investment-research.service.d/secrets.conf by deploy.sh,
# same pattern as the scheduler service) or override directly, then:
# systemctl daemon-reload && systemctl restart investment-research-webhook
#
# A genuinely random secret shared with GitHub's webhook config — the
# listener refuses to start without it. Generate with:
#   openssl rand -hex 32
Environment=GITHUB_WEBHOOK_SECRET=
# Local-only port; Caddy reverse-proxies /webhook/deploy to it over HTTPS
# (see Caddyfile) — this service is never exposed directly.
Environment=WEBHOOK_LISTEN_PORT=8600

# Logging: send stdout/stderr to the systemd journal
# View with: journalctl -u investment-research-webhook -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=investment-research-webhook

[Install]
WantedBy=multi-user.target
