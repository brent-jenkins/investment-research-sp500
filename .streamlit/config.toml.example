# .streamlit/config.toml — Streamlit server configuration for Linux deployment
#
# This file is created automatically on the server by setup.sh.
# It is NOT committed to git (.streamlit/ is gitignored).
#
# To use locally on Windows, copy this to .streamlit/config.toml and
# remove or adjust the server.address line.

[server]
# Only listen on loopback; Caddy handles the public-facing HTTPS port.
headless = true
port = 8501
address = "127.0.0.1"
enableCORS = false
# XSRF protection can interfere with Caddy's reverse proxy; Caddy's TLS
# + basicauth provides the security boundary instead.
enableXsrfProtection = false

[browser]
gatherUsageStats = false
# External URL used when Streamlit generates share links.
# Replace with your actual domain after running setup.sh.
serverAddress = "research.yourdomain.com"
serverPort = 443

[client]
# "minimal" hides the Deploy button and reduces top-bar clutter.
toolbarMode = "minimal"

[general]
# Reserved for future general-level settings. The browser tab title/icon
# come from st.set_page_config(page_title="SP500Invest", page_icon="Z") in
# main.py, not from a config.toml key — Streamlit has no [general] title
# option — so this section is intentionally left empty for now.

[theme]
# SP500Invest dark navy brand theme — matches example.com and the pitch deck.
# This drives the global background, sidebar background, input fields,
# buttons, and primary accent colour automatically; custom inline HTML
# elsewhere in main.py (cards, tables, badges) is colour-matched to these
# same values by hand — see "SP500Invest brand identity" in CLAUDE.md.
primaryColor = "#00C2FF"
backgroundColor = "#0A0F1E"
secondaryBackgroundColor = "#111829"
textColor = "#CCDDEE"
font = "sans serif"
