# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments
.venv/
venv/
ENV/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Database files (contains real financial data — do not commit)
database/*.db
database/*.db-shm
database/*.db-wal
database/prod_backups/

# Streamlit — config.toml is generated on the server by setup.sh (server-specific
# settings: port, address, domain). The example template is tracked instead.
# secrets.toml may contain API keys added via st.secrets in future.
.streamlit/config.toml
.streamlit/secrets.toml

# Server-specific config files — contain bcrypt hashes / server IP.
# Edit these directly on the server; do not commit them.
Caddyfile
get-pip.py

# SSH private keys
ssh-keys/

# Runtime lock directory created by deploy.sh on the server (mutual
# exclusion between overlapping deploy triggers) — never meant to be committed.
.deploy.lock.d

# Deployed commit hash, written by deploy.sh on the server at deploy time
# (read by the Status page to show/link the currently-running commit) —
# server-generated runtime state, never meant to be committed.
.deployed_commit

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Disposable research artifacts — regenerable caches, run logs, and bulk
# rejection dumps produced by research/ scripts across many studies. Scoped
# to research/ specifically (not repo-wide) so these naming conventions
# never accidentally ignore an unrelated file elsewhere. Trade-level CSVs
# backing a shipped finding (trades_*.csv, panel_*.csv, REPORT.md) are
# deliberately NOT covered here — see CLAUDE.md's "Research reproducibility
# standard" for why those stay committed.
research/**/_cache*.pkl
research/**/_log_*.txt
research/**/rejections_*.csv
