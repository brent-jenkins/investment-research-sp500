# Caddyfile — reverse proxy for the Investment Research Dashboard
#
# This file is copied to /etc/caddy/Caddyfile by setup.sh, which also
# substitutes YOUR.DOMAIN.COM with your real domain automatically.
#
# Access control lives in the app itself (per-user accounts, see auth.py
# and CLAUDE.md's "Authentication" section) rather than here — Caddy's
# `basic_auth` directive used to gate the whole site behind one shared
# credential; that has been removed in favour of real per-user login,
# so this file is TLS + reverse proxy only.
#
# After editing /etc/caddy/Caddyfile on the server:
#   systemctl reload caddy

YOUR.DOMAIN.COM {

    # ── GitHub webhook deploy listener ──────────────────────────────────────
    # webhook_listener.py (investment-research-webhook.service) listens on
    # loopback only — this is the sole way it's reachable from the internet.
    # The listener itself verifies GitHub's HMAC signature before acting on
    # anything; Caddy does no auth here, same division of responsibility as
    # the Streamlit proxy below (access control lives in the proxied service,
    # not in Caddy). Must be matched before the catch-all Streamlit proxy.
    handle /webhook/* {
        reverse_proxy localhost:8600
    }

    # ── Streamlit reverse proxy ───────────────────────────────────────────
    # flush_interval -1 disables response buffering, which is required for
    # Streamlit's Server-Sent Events (live progress bars, reruns).
    # Caddy handles WebSocket upgrades automatically.
    handle {
        reverse_proxy localhost:8501 {
            flush_interval -1
        }
    }

    # ── TLS ───────────────────────────────────────────────────────────────
    # Caddy obtains and auto-renews a Let's Encrypt certificate.
    # Ensure your domain's A record points to this server's public IP
    # and that ports 80 and 443 are open in your cloud firewall before
    # running setup.sh.
}
