[Unit]
Description=Investment Research Dashboard (Streamlit)
Documentation=https://github.com/YOUR/investment-research
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/investment-research

ExecStart=/usr/local/bin/streamlit run /root/investment-research/main.py

# Restart policy: always restart, with a 10-second backoff, up to 5 times
# before systemd considers the service failed
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
# Secrets — set real values in /etc/systemd/system/investment-research.service.d/secrets.conf
# or override these lines directly after running setup.sh, then: systemctl daemon-reload && systemctl restart investment-research
Environment=FRED_API_KEY=
Environment=SMTP_PASSWORD=
# Trading212 Invest API credentials (get from T212 → Settings → API)
# Required for the T212 Invest account integration (trading212_invest.enabled in config.yaml)
Environment=T212_API_KEY=
Environment=T212_API_SECRET=

# Logging: send stdout/stderr to the systemd journal
# View with: journalctl -u investment-research -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=investment-research

[Install]
WantedBy=multi-user.target
